      "versionNonce": 1054546999,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742351808016,
      "link": null,
      "locked": false,
      "text": "Make a conscious effort to buy from Black, Indigenous, LGBTQ+, and\nimmigrant-owned businesses in your area. Your purchases help sustain these\nbusinesses and contribute to economic equity. Share your favorite local\nbusinesses with others and encourage them to do the same.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Make a conscious effort to buy from Black, Indigenous, LGBTQ+, and immigrant-owned businesses in your area. Your purchases help sustain these businesses and contribute to economic equity. Share your favorite local businesses with others and encourage them to do the same.",
      "autoResize": false,
      "lineHeight": 1.25
    },
