      "type": "text",
      "x": -239.04048072184446,
      "y": 1186.4773278823177,
      "width": 476.6531895228789,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
