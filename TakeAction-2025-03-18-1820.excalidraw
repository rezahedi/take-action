    {
      "id": "3oD8Muzhp3T0PVOc4PctI",
      "type": "text",
      "x": 737.3979956782002,
      "y": 1474.4346459382216,
      "width": 606.6765161974863,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Q",
      "roundness": null,
      "seed": 1752129657,
      "version": 842,
      "versionNonce": 2097599898,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742577810292,
      "link": null,
      "locked": false,
      "text": "A simple conversation or small act of kindness can mean a lot, especially for\nelderly neighbors, single parents, or marginalized individuals who may feel\nisolated. Offer help, start a friendly chat, or just let them know they’re not\nalone. Kindness builds stronger, more connected communities.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A simple conversation or small act of kindness can mean a lot, especially for elderly neighbors, single parents, or marginalized individuals who may feel isolated. Offer help, start a friendly chat, or just let them know they’re not alone. Kindness builds stronger, more connected communities.",
      "autoResize": false,
      "lineHeight": 1.25
    },
