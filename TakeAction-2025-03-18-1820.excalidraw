      "index": "b0p",
      "roundness": null,
      "seed": 1225355223,
      "version": 389,
      "versionNonce": 1608618871,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742351808016,
      "link": null,
      "locked": false,
      "text": "I created this mission after reading an article on how simple, daily actions can\nhelp counter negativity and build a more compassionate society. We often feel\npowerless in the face of injustice, but change starts with small, intentional steps.\nWhether it’s supporting marginalized communities, speaking up against\ndiscrimination, or simply being kinder in daily interactions, every action counts.\nLet’s take these steps together and inspire more people to do the same.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I created this mission after reading an article on how simple, daily actions can help counter negativity and build a more compassionate society. We often feel powerless in the face of injustice, but change starts with small, intentional steps. Whether it’s supporting marginalized communities, speaking up against discrimination, or simply being kinder in daily interactions, every action counts. Let’s take these steps together and inspire more people to do the same.",
      "autoResize": false,
      "lineHeight": 1.25
    },
