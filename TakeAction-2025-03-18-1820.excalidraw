    {
      "id": "FOQgT3oinzree9kUXGO9a",
      "type": "text",
      "x": 736.4573159076278,
      "y": 1017.6987689398959,
      "width": 606.6765161974863,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
