      "seed": 2112252087,
      "version": 739,
      "versionNonce": 246960919,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742355924862,
      "link": null,
      "locked": false,
      "text": "Old gadgets shouldn’t end up in landfills. Donate, recycle, or\nrepurpose your used electronics, and encourage others to do\nthe same to reduce tech waste and environmental harm.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old gadgets shouldn’t end up in landfills. Donate, recycle, or repurpose your used electronics, and encourage others to do the same to reduce tech waste and environmental harm.",
      "autoResize": false,
      "lineHeight": 1.25
    },
