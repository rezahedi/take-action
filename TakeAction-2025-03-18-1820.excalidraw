    {
      "id": "7YTPkbyhJisjMQqdUDBeZ",
      "type": "text",
      "x": 736.2334607029459,
      "y": 343.3716670092607,
      "width": 646.4286903669786,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
