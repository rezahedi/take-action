    },
    {
      "id": "yJ4UXe0-wIW8GOuB2skow",
      "type": "text",
      "x": 736.7065765903533,
      "y": 1241.150409032127,
      "width": 606.6765161974863,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 588259257,
      "version": 774,
      "versionNonce": 1826726589,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1742831329826,
      "link": null,
      "locked": false,
      "text": "Local policies impact marginalized groups the most, so being involved matters.\nAttend school board meetings, city council sessions, or community\ndiscussions, and advocate for policies that promote inclusion and fairness. If\nyou can’t attend, encourage others to show up or write to your\nrepresentatives.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Local policies impact marginalized groups the most, so being involved matters. Attend school board meetings, city council sessions, or community discussions, and advocate for policies that promote inclusion and fairness. If you can’t attend, encourage others to show up or write to your representatives.",
      "autoResize": false,
      "lineHeight": 1.25
    },
